.message{text-align:center;color:#ddd;background:#211b2c;padding:15px;border-radius:10px}

.person{
  background:#211b2c;
  border:2px solid #40334f;
  border-radius:13px;
  padding:15px;
  margin:12px 0;
}
.person h3{margin:0 0 10px;color:white}
.status{font-size:11px;color:#eee;margin-left:7px}
.stats{color:white;margin:8px 0}
.average{font-size:20px;color:white;font-weight:bold}
.bar{height:9px;background:#493d59;border-radius:10px;overflow:hidden;margin:8px 0}
.bar span{display:block;height:100%;background:#fff}

button.vote{
  background:white;
  color:#17111f;
  border:0;
  border-radius:8px;
  padding:10px 15px;
  font-weight:bold;
  cursor:pointer;
}
button.vote:disabled{background:#777;color:#ddd;cursor:not-allowed}
select{background:#fff;color:#17111f;padding:9px;border-radius:8px;border:0}

/* COULEURS POPULARITÉ */
.person.pop-red{background:#8b2028;border-color:#ff5555}
.person.pop-black{background:#050505;border-color:#555}
.person.pop-yellow{background:#b58b08;border-color:#f5d442}
.person.pop-blue{background:#123d78;border-color:#438bff}

/* COULEURS NOTES DU PUBLIC */
.person.note-red{background:#8b2028;border-color:#ff5555}
.person.note-orange{background:#a84e0b;border-color:#ff9b36}
.person.note-yellow{background:#b58b08;border-color:#f5d442}
.person.note-green{background:#176b3a;border-color:#39d477}

footer{text-align:center;color:#80768f;padding:25px;font-size:12px}
</style>
</head>

<body>

<header>
  <h1>⭐ Télé Réal’Stats ⭐</h1>
  <p>Les statistiques de la télé-réalité</p>
</header>

<nav class="tabs">
  <button class="tab active" data-panel="popularity">📊 Popularité</button>
  <button class="tab" data-panel="nominations">🛑 Nominations</button>
  <button class="tab" data-panel="top3">⭐ Top 3</button>
