</main>

<footer>Télé Réal’Stats — Site non officiel</footer>

<script>
const SUPABASE_URL = "https://qdibctjpzozlpngvjsvc.supabase.co";
const SUPABASE_KEY = "sb_publishable_X5SZIRRcg8wiInW1GQTvCw_eZKRPCmA";

const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

const candidates = [
  {name:"Noémie", status:"IMMUNISÉE", canVote:true},
  {name:"Maud", status:"EN COMPÉTITION", canVote:true},
  {name:"Brieuc", status:"EN COMPÉTITION", canVote:true},
  {name:"Leeloo", status:"EN COMPÉTITION", canVote:true},
  {name:"Tracy", status:"EN COMPÉTITION", canVote:true},
  {name:"Félix", status:"EN COMPÉTITION", canVote:true},
  {name:"Morgan", status:"EN COMPÉTITION", canVote:true},
  {name:"Cameron", status:"EN COMPÉTITION", canVote:true},
  {name:"Amel", status:"EN COMPÉTITION", canVote:true},
  {name:"Isabella", status:"EN COMPÉTITION", canVote:true},
  {name:"Ydriss", status:"EN COMPÉTITION", canVote:true},
  {name:"Melina", status:"EN COMPÉTITION", canVote:true},
  {name:"Kylian", status:"EN COMPÉTITION", canVote:true},
  {name:"Zoe", status:"EN COMPÉTITION", canVote:true},
  {name:"Antoine", status:"ÉLIMINÉ", canVote:false},
  {name:"Elija", status:"ÉLIMINÉ", canVote:false},
  {name:"Khalil", status:"ABANDON", canVote:false}
];

const ratingCandidates = [
  "Noémie",
  "Kylian",
  "Melina",
  "Brieuc",
  "Leeloo",
  "Tracy",
  "Félix",
  "Morgan",
  "Cameron",
  "Amel",
  "Isabella",
  "Zoe",
  "Maud",
  "Ydriss",
  "Antoine"
];

/* IDENTIFIANT DU NAVIGATEUR */
const browserKey = "starAcademyRatingsBrowserId";
let browserId = localStorage.getItem(browserKey);

if (!browserId) {
  browserId = window.crypto && typeof window.crypto.randomUUID === "function"
    ? window.crypto.randomUUID()
    : "browser-" + Date.now() + "-" + Math.random();

  localStorage.setItem(browserKey, browserId);
}

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, c => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[c]);
}

/* ONGLETS */
document.querySelectorAll(".tab").forEach(button => {
  button.addEventListener("click", () => {
    document.querySelectorAll(".tab").forEach(b => b.classList.remove("active"));
    document.querySelectorAll(".panel").forEach(p => p.classList.remove("active"));

    button.classList.add("active");
    document.getElementById(button.dataset.panel).classList.add("active");

    if (button.dataset.panel === "notes") refreshRatings();
    if (button.dataset.panel === "popularity") refreshVotes();
  });
});

/* COULEURS POPULARITÉ */
function popularityColor(name) {
  if (name === "Elija" || name === "Antoine") return "pop-red";
  if (name === "Khalil") return "pop-black";
  if (name === "Noémie") return "pop-yellow";
  return "pop-blue";
}

/* CHARGEMENT DES VOTES */
let votesLoading = false;

async function refreshVotes() {
  const container = document.getElementById("votes-list");

  if (votesLoading) return;
  votesLoading = true;
  container.innerHTML = '<p class="message">Chargement des votes...</p>';

  let timeoutId;

  try {
    const request = db.from("votes").select("candidate");

    const timeout = new Promise((_, reject) => {
      timeoutId = setTimeout(
        () => reject(new Error("Le serveur met trop de temps à répondre.")),
        12000
      );
    });

    const {data, error} = await Promise.race([request, timeout]);
    if (error) throw error;

    const counts = {};
    candidates.filter(c => c.canVote).forEach(c => {
      counts[c.name] = 0;
    });

    data.forEach(row => {
      if (Object.prototype.hasOwnProperty.call(counts, row.candidate)) {
        counts[row.candidate]++;
      }
    });

    const total = Object.values(counts).reduce((a,b) => a+b, 0);

    const sorted = candidates.slice().sort((a,b) => {
      if (!a.canVote && !b.canVote) return 0;
      if (!a.canVote) return 1;
      if (!b.canVote) return -1;
      return counts[b.name] - counts[a.name];
    });

    container.innerHTML = "";

    sorted.forEach(c => {
      const count = c.canVote ? counts[c.name] : 0;
      const percent = c.canVote && total ? count / total * 100 : 0;

      const div = document.createElement("div");
      div.className = "person " + popularityColor(c.name);

      div.innerHTML = `
        <h3>${escapeHTML(c.name)}
          <span class="status">${escapeHTML(c.status)}</span>
        </h3>

        ${c.canVote ? `
          <div class="stats">
            ${count} vote(s) — ${percent.toFixed(1)} %
          </div>
          <div class="bar">
            <span style="width:${percent}%"></span>
          </div>
          <button class="vote" data-name="${escapeHTML(c.name)}">VOTER</button>
        ` : `
          <div class="stats">
            ${c.name === "Antoine" ? "15e" : c.name === "Elija" ? "16e" : "17e"}
          </div>
          <button class="vote" disabled>VOTE IMPOSSIBLE</button>
        `}
      `;

      container.appendChild(div);
    });

    container.querySelectorAll("button[data-name]").forEach(button => {
      button.addEventListener("click", () => submitVote(button.dataset.name, button));
    });

  } catch (error) {
    container.innerHTML = `
      <p class="message">Impossible de charger les votes : ${escapeHTML(error.message)}</p>
      <button class="vote" id="retry-votes">RÉESSAYER</button>
    `;
    document.getElementById("retry-votes").addEventListener("click", refreshVotes);

  } finally {
    clearTimeout(timeoutId);
    votesLoading = false;
  }
}

/* ENREGISTRER UN VOTE */
async function submitVote(name, button) {
  button.disabled = true;
  button.textContent = "ENVOI...";

  const {error} = await db.from("votes").insert({
    candidate: name
  });

  if (error) {
    alert("Erreur lors du vote : " + error.message);
    button.disabled = false;
    button.textContent = "VOTER";
    return;
  }

  await refreshVotes();
}

/* COULEURS DES NOTES */
function ratingColor(name) {
  if (name === "Antoine") return "note-red";
  if (name === "Maud" || name === "Ydriss") return "note-orange";
  if (name === "Noémie") return "note-yellow";
  if (name === "Melina" || name === "Kylian") return "note-green";
  return "";
}
