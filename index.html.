<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
*{box-sizing:border-box}
body{margin:0;background:#100d19;color:white;font-family:Arial,sans-serif}
header{text-align:center;padding:25px 10px;background:linear-gradient(135deg,#21143c,#080711)}
h1{margin:0;color:#f3c85b;font-size:30px}
header p{color:#c9b9e8;margin-bottom:0}

.tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;padding:15px}
.tab{background:#292239;color:white;border:1px solid #55456e;padding:12px;border-radius:10px;font-weight:bold}
.tab.active{background:#e5b943;color:#17111f}

main{max-width:850px;margin:auto;padding:10px}
.panel{display:none}
.panel.active{display:block}
.subtitle{text-align:center;color:#d8c8ed}
